# Telegram API credentials (required to run).
# Get them at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: pre-fill the phone number in the sign-in flow.
# PHONE=

# Sentry telemetry (optional — telemetry stays disabled until both are set).
# SENTRY_DSN: Sentry → Settings → Projects → <project> → Client Keys (DSN).
# SENTRY_OTLP_URL: the project's OTLP ingestion endpoint, typically
#   https://o<org>.ingest.sentry.io/api/<project_id>/integration/otlp
SENTRY_DSN=
SENTRY_OTLP_URL=